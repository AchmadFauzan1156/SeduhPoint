# Salin menjadi .env lalu sesuaikan. File .env tidak ikut di-commit.
# Alamat server web
ADDR=127.0.0.1:8080
# Koneksi MySQL/MariaDB: user:password@tcp(host:port)/nama_database?opsi
# Contoh dengan password: DB_DSN=root:rahasia@tcp(127.0.0.1:3306)/seduhpoint?parseTime=true&charset=utf8mb4&loc=Asia%2FJakarta
DB_DSN=root:@tcp(127.0.0.1:3306)/seduhpoint?parseTime=true&charset=utf8mb4&loc=Asia%2FJakarta
